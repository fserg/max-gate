# Create with: uv run maxgate gen-key. Keep the key with the encrypted DB backup.
MAXGATE_SECRET_KEY=
MAXGATE_UI_PASSWORD=
MAXGATE_INTERNAL_TOKEN=

# Local paths and ports; compose overrides DATA_DIR and API binding for bridge.
MAXGATE_DATA_DIR=temp/data
MAXGATE_API_HOST=127.0.0.1
MAXGATE_API_PORT=8787
MAXGATE_INTERNAL_URL=http://127.0.0.1:8787
MAXGATE_SHUTDOWN_TIMEOUT=30

# Optional explicit MAX client version (omit to use the latest catalogue version).
# MAXGATE_MAX_APP_VERSION=26.31.0

# Development seed-account only. Not required when creating Account in the UI.
# TEL=
# TG_BOT_TOKEN=
# MAX_PASS=
